//@version=6
strategy("STRAT-20260903-DONCHIAN_EMA_BREAK-M30-v1.0", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, currency = currency.USD, margin_long = 5.0, margin_short = 5.0)

// ==============================================================================
// BLOQUE 0: CABECERA INSTITUCIONAL Y METADATOS
// Autor: QRT Solutions
// Estrategia: Ruptura de Canal Donchian (20) con Filtro Estructural EMA 200 y Triple Barrera
// UUID: STRAT-20260903-DONCHIAN_EMA_BREAK-M30-v1.0
// Citas: Richard Donchian (1970); Perry J. Kaufman (2013); Marcos Lopez de Prado (2018)
// ==============================================================================

// ==============================================================================
// BLOQUE 1: PARAMETROS DE ENTRADA Y VARIABLES DE CONFIGURACION (INPUTS)
// ==============================================================================
var string GRP_SETUP = "=== Parametros de Ruptura y Filtro Tendencial ==="
int  inp_donchian_len = input.int(20, "Periodo Canal Donchian", group = GRP_SETUP, minval = 5, maxval = 100)
int  inp_macro_ema    = input.int(200, "Periodo EMA Macro Filtro", group = GRP_SETUP, minval = 50, maxval = 500)

var string GRP_TRIPLE = "=== Triple Barrera de Lopez de Prado ==="
float inp_tp_mult   = input.float(1.50, "Multiplicador Take Profit (ATR D1)", group = GRP_TRIPLE, step = 0.05, minval = 0.5, maxval = 5.0)
float inp_sl_mult   = input.float(0.75, "Multiplicador Stop Loss (ATR D1)", group = GRP_TRIPLE, step = 0.05, minval = 0.2, maxval = 3.0)
int   inp_max_bars  = input.int(32, "Barrera Temporal Maxima (Barras M30 = 16h)", group = GRP_TRIPLE, minval = 5, maxval = 150)

var string GRP_MTF = "=== Filtro de Regimen MTF Diario ==="
int   inp_atr_d_fast = input.int(5, "ATR Rapido Diario", group = GRP_MTF)
int   inp_atr_d_slow = input.int(14, "ATR Lento Diario (Base Barreras)", group = GRP_MTF)
float inp_z_min      = input.float(-0.67, "Umbral Minimo Z-Score Volatilidad", group = GRP_MTF, step = 0.01)

var string GRP_VISUAL = "=== Diagnostico Visual y Telemetria ==="
bool inp_show_hud    = input.bool(true, "Mostrar Panel HUD", group = GRP_VISUAL)
bool inp_show_levels = input.bool(true, "Mostrar Canales y Niveles", group = GRP_VISUAL)

// ==============================================================================
// BLOQUE 2: GUARDA DE CALENTAMIENTO Y MEDIDOR DE HISTORIAL
// ==============================================================================
float d_atr_slow = request.security(syminfo.tickerid, "D", ta.atr(inp_atr_d_slow)[1], lookahead = barmerge.lookahead_off)
float d_atr_fast = request.security(syminfo.tickerid, "D", ta.atr(inp_atr_d_fast)[1], lookahead = barmerge.lookahead_off)

// Calentamiento: Buffers de EMA 200 y Donchian disponibles mas ATR diario cerrado
bool is_warmed_up = bar_index > (inp_macro_ema + inp_donchian_len + 20) and not na(d_atr_slow)

// ==============================================================================
// BLOQUE 3: CALCULOS MTF Y LIBRES DE REPAINTING (SHIFT = 1)
// ==============================================================================
// Media Movil Exponencial estructural en M30
float ema_macro = ta.ema(close, inp_macro_ema)

// Canal Donchian de los N periodos previos a la vela analizada (shift 2 a N+1)
float donchian_high = ta.highest(high, inp_donchian_len)[2]
float donchian_low  = ta.lowest(low, inp_donchian_len)[2]
float donchian_mid  = (donchian_high + donchian_low) / 2.0

// Normalizacion Z-Score Diario de Lopez de Prado
float d_atr_sma   = request.security(syminfo.tickerid, "D", ta.sma(ta.atr(inp_atr_d_fast), 14)[1], lookahead = barmerge.lookahead_off)
float d_atr_stdev = request.security(syminfo.tickerid, "D", ta.stdev(ta.atr(inp_atr_d_fast), 14)[1], lookahead = barmerge.lookahead_off)
float z_score_d1  = d_atr_stdev > 0.0 ? (d_atr_fast - d_atr_sma) / d_atr_stdev : 0.0

// ==============================================================================
// BLOQUE 4: SENALES CUANTITATIVAS (EVALUADAS AL CIERRE DE VELA [1])
// ==============================================================================
// Ruptura valida: La barra [1] cruza por encima del maximo o por debajo del minimo previo
bool breakout_bull = (close[1] > donchian_high) and (close[2] <= donchian_high)
bool breakout_bear = (close[1] < donchian_low)  and (close[2] >= donchian_low)

// Filtro tendencial macro institucional
bool filter_bull = close[1] > ema_macro[1]
bool filter_bear = close[1] < ema_macro[1]

// Filtro de volatilidad Z-Score
bool vol_ok = z_score_d1 >= inp_z_min

// Senales de entrada
bool long_signal  = is_warmed_up and breakout_bull and filter_bull and vol_ok and (strategy.position_size == 0)
bool short_signal = is_warmed_up and breakout_bear and filter_bear and vol_ok and (strategy.position_size == 0)

// ==============================================================================
// BLOQUE 5: EJECUCION DE ORDENES Y TRIPLE BARRERA
// ==============================================================================
var float entry_price = 0.0
var float tp_price    = 0.0
var float sl_price    = 0.0
var int   bars_in_pos = 0

if (long_signal)
    entry_price := close
    tp_price    := close + (d_atr_slow * inp_tp_mult)
    sl_price    := close - (d_atr_slow * inp_sl_mult)
    bars_in_pos := 0
    strategy.entry("Donchian_Break_Long", strategy.long)

if (short_signal)
    entry_price := close
    tp_price    := close - (d_atr_slow * inp_tp_mult)
    sl_price    := close + (d_atr_slow * inp_sl_mult)
    bars_in_pos := 0
    strategy.entry("Donchian_Break_Short", strategy.short)

// ==============================================================================
// BLOQUE 6: MOTOR DE SALIDA (TRIPLE BARRERA & INVALIDACION ESTRUCTURAL)
// ==============================================================================
if (strategy.position_size != 0)
    bars_in_pos += 1
    
    // Barrera 3: Limite temporal (Time Stop de 32 barras = 16h)
    bool time_stop = bars_in_pos >= inp_max_bars
    
    // Invalidacion Estructural: Perdida de la EMA 200 al cierre
    bool invalidation_long  = (strategy.position_size > 0) and (close[1] < ema_macro[1])
    bool invalidation_short = (strategy.position_size < 0) and (close[1] > ema_macro[1])
    
    if (time_stop)
        strategy.close_position("Time_Stop_Exit")
    else if (invalidation_long or invalidation_short)
        strategy.close_position("EMA200_Invalidation")
    else
        strategy.exit("Exit_Long", from_entry = "Donchian_Break_Long", limit = tp_price, stop = sl_price)
        strategy.exit("Exit_Short", from_entry = "Donchian_Break_Short", limit = tp_price, stop = sl_price)

// ==============================================================================
// BLOQUE 7: DIAGNOSTICO VISUAL Y PANEL HUD INSTITUCIONAL
// ==============================================================================
plot(inp_show_levels ? donchian_high : na, "Donchian High (20)", color = color.new(color.green, 40), linewidth = 1, style = plot.style_stepline)
plot(inp_show_levels ? donchian_low  : na, "Donchian Low (20)",  color = color.new(color.red, 40),   linewidth = 1, style = plot.style_stepline)
plot(inp_show_levels ? donchian_mid  : na, "Donchian Mid (20)",  color = color.new(color.gray, 60),  linewidth = 1, style = plot.style_circles)
plot(ema_macro, "EMA 200 Macro", color = color.purple, linewidth = 2)

plot(strategy.position_size != 0 ? tp_price : na, "Take Profit (1.5x ATR D1)", color = color.green, style = plot.style_linebr, linewidth = 1)
plot(strategy.position_size != 0 ? sl_price : na, "Stop Loss (0.75x ATR D1)",   color = color.red,   style = plot.style_linebr, linewidth = 1)

var table dash = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 15), border_color = color.gray, border_width = 1)
if (barstate.islast and inp_show_hud)
    table.cell(dash, 0, 0, "ESTRATEGIA", text_color = color.white, text_size = size.small, text_font = font.family_monospace)
    table.cell(dash, 1, 0, "DONCHIAN 20 + EMA 200", text_color = color.yellow, text_size = size.small, text_font = font.family_monospace)
    table.cell(dash, 0, 1, "ATR D1 (14)", text_color = color.white, text_size = size.small, text_font = font.family_monospace)
    table.cell(dash, 1, 1, str.tostring(d_atr_slow, "#.##"), text_color = color.white, text_size = size.small, text_font = font.family_monospace)
    table.cell(dash, 0, 2, "Z-Score D1", text_color = color.white, text_size = size.small, text_font = font.family_monospace)
    table.cell(dash, 1, 2, str.tostring(z_score_d1, "#.##"), text_color = z_score_d1 >= 0 ? color.green : color.red, text_size = size.small, text_font = font.family_monospace)
    table.cell(dash, 0, 3, "Posicion", text_color = color.white, text_size = size.small, text_font = font.family_monospace)
    table.cell(dash, 1, 3, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray, text_size = size.small, text_font = font.family_monospace)
    table.cell(dash, 0, 4, "Barras en Pos", text_color = color.white, text_size = size.small, text_font = font.family_monospace)
    table.cell(dash, 1, 4, str.tostring(bars_in_pos) + " / " + str.tostring(inp_max_bars), text_color = color.white, text_size = size.small, text_font = font.family_monospace)
    table.cell(dash, 0, 5, "Autor", text_color = color.white, text_size = size.small, text_font = font.family_monospace)
    table.cell(dash, 1, 5, "QRT Solutions", text_color = color.aqua, text_size = size.small, text_font = font.family_monospace)
