//@version=6
strategy("STRAT-20260902-GOLD_PULLBACK_EMA-M30-v1.0", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, currency = currency.USD, margin_long = 5.0, margin_short = 5.0)

// ==============================================================================
// BLOQUE 1: CABECERA INSTITUCIONAL Y METADATA
// Autor: QRT Solutions
// Estrategia: Tendencia de Fibonacci con Entrada en Retroceso (Pullback EMA 13/34/89)
// UUID: STRAT-20260902-GOLD_PULLBACK_EMA-M30-v1.0
// Citas: Tushar Chande & Stanley Kroll (1994), Marcos Lopez de Prado (2018)
// ==============================================================================

// ==============================================================================
// BLOQUE 2: PARAMETROS DE ENTRADA Y VARIABLES DE ESTADO
// ==============================================================================
var string GRP_IND = "=== Indicadores Tecnicos de Tendencia ==="
int  inp_fast_len   = input.int(13, "Periodo EMA Rapida", group = GRP_IND, minval = 2)
int  inp_med_len    = input.int(34, "Periodo EMA Media", group = GRP_IND, minval = 5)
int  inp_slow_len   = input.int(89, "Periodo EMA Macro", group = GRP_IND, minval = 10)

var string GRP_TRIPLE = "=== Triple Barrera de Lopez de Prado ==="
float inp_tp_mult   = input.float(1.5, "Multiplicador Take Profit (ATR D1)", group = GRP_TRIPLE, step = 0.1)
float inp_sl_mult   = input.float(0.75, "Multiplicador Stop Loss (ATR D1)", group = GRP_TRIPLE, step = 0.05)
int   inp_max_bars  = input.int(32, "Barrera Temporal Maxima (Barras M30 = 16h)", group = GRP_TRIPLE, minval = 5)

var string GRP_MTF = "=== Filtro de Regimen MTF Diario ==="
int   inp_atr_d_fast = input.int(5, "ATR Rapido Diario", group = GRP_MTF)
int   inp_atr_d_slow = input.int(14, "ATR Lento Diario", group = GRP_MTF)

// ==============================================================================
// BLOQUE 3: CALCULOS MTF Y LIBRES DE REPAINTING (SHIFT = 1)
// ==============================================================================
// Medias Moviles de Fibonacci en marco temporal actual (M30)
float ema_fast = ta.ema(close, inp_fast_len)
float ema_med  = ta.ema(close, inp_med_len)
float ema_slow = ta.ema(close, inp_slow_len)

// ATR Diario cerrado (shift = 1) para calculo de barreras dinamicas
float d_atr_fast = request.security(syminfo.tickerid, "D", ta.atr(inp_atr_d_fast)[1], lookahead = barmerge.lookahead_off)
float d_atr_slow = request.security(syminfo.tickerid, "D", ta.atr(inp_atr_d_slow)[1], lookahead = barmerge.lookahead_off)

// Z-Score de volatilidad diaria de Lopez de Prado
float d_atr_sma    = request.security(syminfo.tickerid, "D", ta.sma(ta.atr(inp_atr_d_fast), 14)[1], lookahead = barmerge.lookahead_off)
float d_atr_stdev  = request.security(syminfo.tickerid, "D", ta.stdev(ta.atr(inp_atr_d_fast), 14)[1], lookahead = barmerge.lookahead_off)
float z_score_d1   = d_atr_stdev > 0 ? (d_atr_fast - d_atr_sma) / d_atr_stdev : 0.0

// Guarda de calentamiento
bool is_warmed_up = bar_index > (inp_slow_len + 15) and not na(d_atr_slow)

// ==============================================================================
// BLOQUE 4: CONDICIONES DE ENTRADA (HIPOTESIS DE PULLBACK)
// ==============================================================================
// Alineacion tendencial de Fibonacci confirmada en la vela cerrada anterior [1]
bool trend_bull = (ema_fast[1] > ema_med[1]) and (ema_med[1] > ema_slow[1])
bool trend_bear = (ema_fast[1] < ema_med[1]) and (ema_med[1] < ema_slow[1])

// Retroceso hacia la zona de valor (Pullback en vela cerrada anterior [1])
bool pullback_bull = (low[1] <= ema_fast[1]) and (low[1] >= (ema_med[1] - d_atr_slow * 0.2))
bool pullback_bear = (high[1] >= ema_fast[1]) and (high[1] <= (ema_med[1] + d_atr_slow * 0.2))

// Gatillo de rechazo del soporte/resistencia dinamico y cierre a favor del impulso
bool rejection_bull = (close[1] > ema_fast[1]) and (close[1] > open[1]) and (close[1] >= (high[1] + low[1]) * 0.5)
bool rejection_bear = (close[1] < ema_fast[1]) and (close[1] < open[1]) and (close[1] <= (high[1] + low[1]) * 0.5)

bool long_signal  = is_warmed_up and trend_bull and pullback_bull and rejection_bull and (strategy.position_size == 0)
bool short_signal = is_warmed_up and trend_bear and pullback_bear and rejection_bear and (strategy.position_size == 0)

// ==============================================================================
// BLOQUE 5: EJECUCION Y GESTION DE POSICION
// ==============================================================================
var float entry_price = 0.0
var float tp_price    = 0.0
var float sl_price    = 0.0
var int   bars_in_pos = 0

if (long_signal)
    entry_price := close
    tp_price    := close + (d_atr_slow * inp_tp_mult)
    sl_price    := close - (d_atr_slow * inp_sl_mult)
    bars_in_pos := 0
    strategy.entry("Long_Pullback", strategy.long)

if (short_signal)
    entry_price := close
    tp_price    := close - (d_atr_slow * inp_tp_mult)
    sl_price    := close + (d_atr_slow * inp_sl_mult)
    bars_in_pos := 0
    strategy.entry("Short_Pullback", strategy.short)

// ==============================================================================
// BLOQUE 6: MOTOR DE SALIDA (TRIPLE BARRERA Y REVERSION TENDENCIAL)
// ==============================================================================
if (strategy.position_size != 0)
    bars_in_pos += 1
    
    // Barrera 3: Limite de tiempo maximo (Time Stop)
    bool time_stop = bars_in_pos >= inp_max_bars
    
    // Salida preventiva si el precio rompe la EMA Media (34) en contra
    bool trend_invalidated_long  = (strategy.position_size > 0) and (close[1] < ema_med[1])
    bool trend_invalidated_short = (strategy.position_size < 0) and (close[1] > ema_med[1])
    
    if (time_stop or trend_invalidated_long)
        strategy.close("Long_Pullback", comment = time_stop ? "B3_TimeStop" : "Macro_Invalidation")
        
    if (time_stop or trend_invalidated_short)
        strategy.close("Short_Pullback", comment = time_stop ? "B3_TimeStop" : "Macro_Invalidation")
        
    // Barreras 1 y 2 (Take Profit y Stop Loss limit/stop)
    if (strategy.position_size > 0)
        strategy.exit("Exit_Long", from_entry = "Long_Pullback", limit = tp_price, stop = sl_price)
    if (strategy.position_size < 0)
        strategy.exit("Exit_Short", from_entry = "Short_Pullback", limit = tp_price, stop = sl_price)

// ==============================================================================
// BLOQUE 7: GRAFICACION Y TELEMETRIA VISUAL
// ==============================================================================
plot(ema_fast, "EMA 13 (Rapida)", color = color.yellow, linewidth = 2)
plot(ema_med,  "EMA 34 (Media)",  color = color.orange, linewidth = 2)
plot(ema_slow, "EMA 89 (Macro)",  color = color.blue,   linewidth = 3)

plotshape(long_signal,  title = "Señal BUY",  style = shape.triangleup,   location = location.belowbar, color = color.lime, size = size.small)
plotshape(short_signal, title = "Señal SELL", style = shape.triangledown, location = location.abovebar, color = color.red,  size = size.small)

// Tabla de Telemetria HUD
var table hud = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 20), border_color = color.gray, border_width = 1)
if (barstate.islast)
    table.cell(hud, 0, 0, "Estrategia", text_color = color.white, text_size = size.small)
    table.cell(hud, 1, 0, "Pullback EMA 13/34/89", text_color = color.yellow, text_size = size.small)
    table.cell(hud, 0, 1, "Tendencia", text_color = color.white, text_size = size.small)
    table.cell(hud, 1, 1, trend_bull ? "ALCISTA (Bull)" : (trend_bear ? "BAJISTA (Bear)" : "NEUTRO / LATERAL"), text_color = trend_bull ? color.green : (trend_bear ? color.red : color.gray), text_size = size.small)
    table.cell(hud, 0, 2, "ATR D1 (14)", text_color = color.white, text_size = size.small)
    table.cell(hud, 1, 2, str.tostring(d_atr_slow, "#.##"), text_color = color.cyan, text_size = size.small)
    table.cell(hud, 0, 3, "Z-Score D1", text_color = color.white, text_size = size.small)
    table.cell(hud, 1, 3, str.tostring(z_score_d1, "#.##"), text_color = z_score_d1 >= 0 ? color.green : color.orange, text_size = size.small)
